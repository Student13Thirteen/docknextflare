#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT_DIR/.env"
DATA_DIR="$ROOT_DIR/data"
BACKUP_DIR="$ROOT_DIR/backups"

if [[ -t 1 ]]; then
  BOLD='\033[1m'; BLUE='\033[34m'; GREEN='\033[32m'; YELLOW='\033[33m'; RED='\033[31m'; RESET='\033[0m'
else
  BOLD=''; BLUE=''; GREEN=''; YELLOW=''; RED=''; RESET=''
fi

info() { printf "%b%s%b\n" "$BLUE" "$*" "$RESET"; }
ok() { printf "%b%s%b\n" "$GREEN" "$*" "$RESET"; }
warn() { printf "%b%s%b\n" "$YELLOW" "$*" "$RESET"; }
die() { printf "%b%s%b\n" "$RED" "$*" "$RESET" >&2; exit 1; }

usage() {
  cat <<'USAGE'
DockNextFlare — one small command for a private cloud you can reach anywhere.

Usage:
  bash docknextflare setup        guided first deployment
  bash docknextflare start        start the stack
  bash docknextflare stop         stop the stack
  bash docknextflare status       show service state
  bash docknextflare doctor       run configuration and runtime checks
  bash docknextflare logs [name]  follow logs (app, db or tunnel)
  bash docknextflare backup       create a timestamped database + files backup
  bash docknextflare update       backup, pull images and restart safely
  bash docknextflare credentials  show the locally stored initial admin login
  bash docknextflare help
USAGE
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

require_docker() {
  need_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (docker compose)."
  docker info >/dev/null 2>&1 || die "Docker is installed but the daemon is not reachable."
}

load_env() {
  [[ -f "$ENV_FILE" ]] || die "Missing .env. Run: bash docknextflare setup"
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48
    printf '\n'
  fi
}

valid_hostname() {
  [[ "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]
}

read_required() {
  local prompt="$1" value
  while true; do
    read -r -p "$prompt" value
    [[ -n "$value" ]] && { printf '%s' "$value"; return; }
    warn "This value is required."
  done
}

read_secret_required() {
  local prompt="$1" value
  while true; do
    read -r -s -p "$prompt" value
    printf '\n' >&2
    [[ -n "$value" ]] && { printf '%s' "$value"; return; }
    warn "This value is required."
  done
}

compose() {
  (cd "$ROOT_DIR" && docker compose "$@")
}

service_state() {
  local service="$1" cid
  cid="$(compose ps -q "$service" 2>/dev/null || true)"
  [[ -n "$cid" ]] || { printf 'not-created'; return; }
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || printf 'unknown'
}

wait_for_app() {
  local attempts="${1:-60}" state i
  info "Waiting for Nextcloud to become healthy..."
  for ((i=1; i<=attempts; i++)); do
    state="$(service_state app)"
    case "$state" in
      healthy) ok "Nextcloud is healthy."; return 0 ;;
      unhealthy|exited|dead) compose logs --tail=80 app >&2 || true; die "Nextcloud entered state: $state" ;;
    esac
    printf '.'
    sleep 5
  done
  printf '\n'
  warn "The stack is still starting. Run 'bash docknextflare doctor' in a minute."
  return 1
}

setup() {
  require_docker
  umask 077

  printf "%bDockNextFlare setup%b\n" "$BOLD" "$RESET"
  printf "A guided deployment for Nextcloud + MariaDB + Cloudflare Tunnel.\n\n"

  if [[ -f "$ENV_FILE" ]]; then
    read -r -p ".env already exists. Replace it? [y/N] " answer
    [[ "${answer,,}" == "y" ]] || die "Setup cancelled; existing configuration was left unchanged."
    cp "$ENV_FILE" "$ENV_FILE.backup.$(date +%Y%m%d_%H%M%S)"
  fi

  local hostname tunnel_token admin_user admin_password db_root_password db_password
  while true; do
    hostname="$(read_required "Public hostname (example: cloud.example.com): ")"
    valid_hostname "$hostname" && break
    warn "Enter a hostname only, without https:// or a path."
  done

  printf "\nCreate a remotely-managed Cloudflare Tunnel and set its Public Hostname service to:\n"
  printf "  %bhttp://app:80%b\n" "$BOLD" "$RESET"
  printf "Then paste the tunnel token below.\n\n"

  tunnel_token="$(read_secret_required "Cloudflare tunnel token: ")"
  read -r -p "Initial Nextcloud admin username [admin]: " admin_user
  admin_user="${admin_user:-admin}"
  admin_password="$(random_secret)"
  db_root_password="$(random_secret)"
  db_password="$(random_secret)"

  cat > "$ENV_FILE.tmp" <<ENV
# Generated by DockNextFlare on $(date -Iseconds)
# Keep this file private. It contains operational credentials.
NEXTCLOUD_HOSTNAME=$hostname
NEXTCLOUD_ADMIN_USER=$admin_user
NEXTCLOUD_ADMIN_PASSWORD=$admin_password
MYSQL_ROOT_PASSWORD=$db_root_password
MYSQL_PASSWORD=$db_password
CLOUDFLARE_TOKEN=$tunnel_token
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=10G
ENV
  chmod 600 "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"

  mkdir -p "$DATA_DIR/nextcloud" "$DATA_DIR/mariadb" "$BACKUP_DIR"

  info "Validating configuration..."
  compose config --quiet

  info "Pulling container images..."
  compose pull

  info "Starting the stack..."
  compose up -d --remove-orphans
  wait_for_app 60 || true

  printf "\n%bReady.%b\n" "$GREEN$BOLD" "$RESET"
  printf "URL:      https://%s\n" "$hostname"
  printf "Username: %s\n" "$admin_user"
  printf "Password: %s\n" "$admin_password"
  printf "\nCredentials are stored only in %s with mode 600.\n" "$ENV_FILE"
  printf "Run %bbash docknextflare doctor%b to verify the complete path.\n" "$BOLD" "$RESET"
}

start() {
  require_docker
  load_env
  compose config --quiet
  compose up -d --remove-orphans
  wait_for_app 60 || true
  ok "Stack started: https://$NEXTCLOUD_HOSTNAME"
}

stop() {
  require_docker
  compose down
  ok "Stack stopped. Persistent data was preserved."
}

status() {
  require_docker
  compose ps
}

doctor() {
  local failures=0 state mode
  printf "%bDockNextFlare doctor%b\n\n" "$BOLD" "$RESET"

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then ok "[ok] Docker Compose v2"; else warn "[fail] Docker Compose v2"; failures=$((failures+1)); fi
  if docker info >/dev/null 2>&1; then ok "[ok] Docker daemon reachable"; else warn "[fail] Docker daemon unreachable"; failures=$((failures+1)); fi

  if [[ -f "$ENV_FILE" ]]; then
    ok "[ok] .env exists"
    mode="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || printf '?')"
    if [[ "$mode" == "600" ]]; then ok "[ok] .env permissions: 600"; else warn "[warn] .env permissions: $mode (recommended: 600)"; fi
    load_env
  else
    warn "[fail] .env missing"
    failures=$((failures+1))
  fi

  if compose config --quiet >/dev/null 2>&1; then ok "[ok] Compose configuration valid"; else warn "[fail] Compose configuration invalid"; failures=$((failures+1)); fi

  for service in db app tunnel; do
    state="$(service_state "$service")"
    case "$state" in
      healthy|running) ok "[ok] $service: $state" ;;
      starting) warn "[wait] $service: starting" ;;
      *) warn "[fail] $service: $state"; failures=$((failures+1)) ;;
    esac
  done

  if [[ "$(service_state app)" == "healthy" ]]; then
    if compose exec -T -u www-data app php occ status >/dev/null 2>&1; then ok "[ok] Nextcloud OCC responds"; else warn "[fail] Nextcloud OCC check"; failures=$((failures+1)); fi
  fi

  if [[ -n "${NEXTCLOUD_HOSTNAME:-}" ]] && command -v curl >/dev/null 2>&1; then
    if curl -fsS --max-time 12 "https://$NEXTCLOUD_HOSTNAME/status.php" >/dev/null; then ok "[ok] Public hostname reachable"; else warn "[warn] Public hostname not reachable yet"; fi
  fi

  printf '\n'
  if (( failures == 0 )); then ok "Doctor completed: no blocking problems found."; else die "Doctor found $failures blocking problem(s)."; fi
}

logs() {
  require_docker
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    [[ "$service" =~ ^(app|db|tunnel)$ ]] || die "Service must be app, db or tunnel."
    compose logs --tail=150 -f "$service"
  else
    compose logs --tail=100 -f
  fi
}

backup() {
  require_docker
  load_env
  [[ "$(service_state db)" =~ ^(healthy|running)$ ]] || die "Database is not running."
  [[ "$(service_state app)" =~ ^(healthy|running)$ ]] || die "Nextcloud is not running."

  local stamp target maintenance_enabled=0
  stamp="$(date +%Y%m%d_%H%M%S)"
  target="$BACKUP_DIR/$stamp"
  mkdir -p "$target"
  chmod 700 "$target"

  cleanup_maintenance() {
    if (( maintenance_enabled == 1 )); then
      compose exec -T -u www-data app php occ maintenance:mode --off >/dev/null 2>&1 || true
    fi
  }
  trap cleanup_maintenance EXIT

  info "Enabling maintenance mode..."
  compose exec -T -u www-data app php occ maintenance:mode --on >/dev/null
  maintenance_enabled=1

  info "Dumping MariaDB..."
  compose exec -T db mariadb-dump -u nextcloud "-p$MYSQL_PASSWORD" nextcloud > "$target/nextcloud.sql"

  info "Archiving Nextcloud files..."
  tar -C "$DATA_DIR" -czf "$target/nextcloud-files.tar.gz" nextcloud

  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$target" && sha256sum nextcloud.sql nextcloud-files.tar.gz > SHA256SUMS)
  elif command -v shasum >/dev/null 2>&1; then
    (cd "$target" && shasum -a 256 nextcloud.sql nextcloud-files.tar.gz > SHA256SUMS)
  fi

  cleanup_maintenance
  maintenance_enabled=0
  trap - EXIT
  chmod -R go-rwx "$target"
  ok "Backup completed: $target"
}

update_stack() {
  require_docker
  load_env
  info "Creating a safety backup before updating..."
  backup
  info "Pulling newer images..."
  compose pull
  compose up -d --remove-orphans
  wait_for_app 60 || true
  ok "Update completed."
}

credentials() {
  load_env
  printf "URL:      https://%s\n" "$NEXTCLOUD_HOSTNAME"
  printf "Username: %s\n" "$NEXTCLOUD_ADMIN_USER"
  printf "Password: %s\n" "$NEXTCLOUD_ADMIN_PASSWORD"
}

main() {
  cd "$ROOT_DIR"
  case "${1:-help}" in
    setup) setup ;;
    start|up) start ;;
    stop|down) stop ;;
    status|ps) status ;;
    doctor|check) doctor ;;
    logs) shift; logs "${1:-}" ;;
    backup) backup ;;
    update) update_stack ;;
    credentials) credentials ;;
    help|-h|--help) usage ;;
    *) usage; die "Unknown command: $1" ;;
  esac
}

main "$@"
